                  "const json = pm.response.json();",
                  "pm.test('Position 1 on the genesis hash', () => {",
                  "    pm.expect(json.sequence).to.eql(1);",
                  "    pm.expect(json.previousHash).to.eql('0'.repeat(64));",
                  "    pm.expect(json.hash).to.match(/^[0-9a-f]{64}$/);",
                  "    pm.expect(json.recordedBy).to.eql(pm.environment.get('executor'));",
                  "});",
                  "pm.environment.set('firstEntryId', json.id);",
                  "pm.environment.set('firstHash', json.hash);"
