{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Automatically generate standard W3C traceparent (ADR-010) and X-Trace-Id",
          "function generateHex(len) {",
          "    let result = '';",
          "    const chars = '0123456789abcdef';",
          "    for (let i = 0; i < len; i++) {",
          "        result += chars.charAt(Math.floor(Math.random() * chars.length));",
          "    }",
          "    return result;",
          "}",
          "const traceId = generateHex(32);",
          "const spanId = generateHex(16);",
          "const traceparent = `00-${traceId}-${spanId}-01`;",
          "pm.request.headers.upsert({ key: 'traceparent', value: traceparent });",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: traceId });",
          "pm.environment.set('currentTraceId', traceId);"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "info": {
    "_exporter_id": "39879181",
    "_postman_id": "b1c3d5e7-9f0a-4b2c-8d4e-6f8a0b2c4d6e",
    "description": "Enterprise-grade E2E Postman Suite for the Compliance Audit Ledger Service Domain (BIAN-aligned, ADR-001/005/013/019/030/031/032). Appends entries under /compliance-audit-ledger/v1 and asserts the per-tenant hash chain (position 1 on the genesis hash, each later entry linked to the hash before it), tenant-scoped retrieval, filters and bounded paging, and the integrity-check/evaluate verdict; negative cases cover validation, tenant isolation and the absence of any update or delete (append-only), with RFC 7807 error_code assertions. It appends under its own generated tenant id (ledgerOrganisationId) because it asserts exact chain positions, so it needs no organisationId from the Party Reference Data Directory.",
    "name": "Compliance Audit Ledger Service - Hash Chain Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
